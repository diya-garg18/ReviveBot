# Copy to .env and fill in. NEVER commit the real .env.

# --- Claude (diagnosis engine) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-opus-4-8).
# CLAUDE_MODEL=claude-sonnet-5

# --- Razorpay (recovery executor, TEST MODE) ---
# Dashboard -> Settings -> API Keys -> Test Mode. Key id starts with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Run mode ---
# 1 = allow offline fallback (rule-based diagnosis + mock comms) when keys are
# missing, so the batch always runs. Set to 0 to require real credentials.
REVIVEBOT_OFFLINE_OK=1
